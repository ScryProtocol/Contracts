# /etc/scp-hub.env (or PM2 env for node/scp-hub/server.js)

HOST=0.0.0.0
PORT=4021
HUB_NAME=pay.eth
NETWORK=sepolia
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x07ECA6701062Db12eDD04bEa391eD226C95aaD4b
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Required secret
HUB_PRIVATE_KEY=0x...

# Optional but recommended
HUB_ADMIN_TOKEN=replace-me
PAYEE_AUTH_MAX_SKEW_SEC=300
FEE_BASE=0
FEE_BPS=0
GAS_SURCHARGE=0

# Storage
STORE_PATH=/root/x402s/node/scp-hub/data/store.json

# Explicit public endpoint used in handle offers generated by hub routes.
HANDLE_HUB_ENDPOINT=https://pogchamp.tv/hub/sepolia
HANDLE_DEFAULT_DOMAIN=pogchamp.tv
HANDLE_ENABLED=1
HANDLE_ASSET=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
HANDLE_PRICE=1000000
# Handle registrations settle to this payee address.
HANDLE_PAYEE_ADDRESS=0x000000000000000000000000000000000000dEaD
