# /etc/handle-api.env
# Source from systemd or PM2 before launching node/handle-api/server.js

HOST=127.0.0.1
PORT=7777

# Sepolia defaults for pogchamp.tv
NETWORK=eip155:11155111
ASSET=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
HUB_NAME=pay.eth
HUB_ENDPOINT=https://pogchamp.tv/hub/sepolia

# Payee wallet shown in the offer extension (set to your real payout wallet)
PAYEE_ADDRESS=0x000000000000000000000000000000000000dEaD

# Amount in smallest units of ASSET (6 decimals for Sepolia USDC)
HANDLE_PRICE=1000000

CORS_ORIGIN=*
